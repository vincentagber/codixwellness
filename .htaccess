# Automatic RewriteBase detection
<IfModule mod_rewrite.c>
RewriteEngine On

#########################################
# FORCE HTTPS
#########################################

RewriteCond %{HTTPS} !=on
RewriteRule ^ https://codixwellness.co.uk%{REQUEST_URI} [R=301,L]

#########################################
# NEVER REWRITE WORDPRESS CORE
#########################################

RewriteRule ^wp-admin/ - [L]
RewriteRule ^wp-login\.php$ - [L]
RewriteRule ^wp-content/ - [L]
RewriteRule ^wp-includes/ - [L]
RewriteRule ^wp-json/? wp-json.php [L,QSA]
RewriteRule ^xmlrpc\.php$ - [L]
RewriteRule ^wp-cron\.php$ - [L]

#########################################
# REST API FALLBACK (?rest_route=...)
#########################################

RewriteCond %{QUERY_STRING} (^|&)rest_route= [NC]
RewriteRule ^ wp-json.php [L,QSA]

#########################################
# CANONICAL STATIC PAGE URLS & HIDE .HTML
#########################################

# 1. External redirect: /index.html -> /
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.*?)index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 2. External redirect: /page.html -> /page
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 3. Canonicalize trailing slash: /page/ -> /page if page.html exists
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} ^(.*?)/+$
RewriteCond %1.html -f
RewriteRule ^(.+?)/+$ $1 [R=301,L]

# 4. Map root request to index.html
RewriteRule ^$ index.html [L]

# 5. Internal rewrite: map clean URL to .html file if it exists
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# 6. Fallback internal rewrite for DocumentRoot
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

RewriteRule ^wp-api/?$ wp-api.php [L,QSA]

#########################################
# EXISTING FILES/FOLDERS
#########################################

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

#########################################
# WORDPRESS
#########################################

RewriteRule ^index\.php$ - [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . index.php [L]

</IfModule>
# BEGIN WordPress
# The directives (lines) between "BEGIN WordPress" and "END WordPress" are
# dynamically generated, and should only be modified via WordPress filters.
# Any changes to the directives between these markers will be overwritten.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>

# END WordPress
